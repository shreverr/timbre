{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "exclude": ["test", "node_modules"]
}
